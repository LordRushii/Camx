# Copy this file to .env.local and fill in real values.
# (convex dev can also write NEXT_PUBLIC_CONVEX_URL for you)

# Convex deployment URL — get it via `npx convex dev` or dashboard.convex.dev
NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud

# LM Studio local server (watch loop + video pipeline)
LMSTUDIO_URL=http://localhost:1234

# Optional: NVIDIA API for cloud video analysis / summarization
# NVIDIA_API_KEY=nvapi-...

# Worker port
PORT=3001
