[TEMPLATE]
# Copy this file to .env.local and fill in real values.
# (convex dev can also write NEXT_PUBLIC_CONVEX_URL for you)

# Convex deployment URL — get it via `npx convex dev` or dashboard.convex.dev
NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud

# --- Provider selection & keys (SERVER-SIDE ONLY — never NEXT_PUBLIC_) ---
# Head of the watch/live provider rotation chain: gemini -> groq -> lmstudio
WATCH_PROVIDER=gemini
# Google AI Studio key (GeminiProvider) — https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-key
# Groq console key (GroqProvider) — https://console.groq.com/keys
GROQ_API_KEY=your-groq-key
# Optional overflow provider (lifetime credits — spent last)
# NVIDIA_API_KEY=nvapi-...

# --- Budget / rate caps (the fail-safe; can never exceed free quota) ---
WATCH_RATE_PER_MIN=8        # hard calls/min cap (repo worker default is 12)
WATCH_RATE_BURST=4          # token-bucket burst allowance
WATCH_MAX_CONCURRENT=2      # max in-flight cloud calls
WATCH_DAILY_BUDGET=500      # per-day hard stop (well under ~1000/day free tier)
WATCH_SESSION_BUDGET=500    # per-session hard stop (resets on server restart)
WATCH_BUDGET_WARN_PCT=80    # amber + proactive-rotation threshold (%)

# --- Smart sampling / token levers ---
WATCH_COOLDOWN_MS=60000     # per-camera cooldown after an alert
WATCH_DOWNSCALE_PX=768      # longest-edge downscale (640-768 recommended)
WATCH_JPEG_QUALITY=50       # JPEG quality for frames sent to the LLM
WATCH_BURST_FRAMES=6        # frames per burst call (clamped 1-10)

# --- Local gate thresholds (browser, high-recall) ---
WATCH_MOTION_THRESHOLD=0.04  # mean-abs-diff (0..1) => "moved"
WATCH_GATE_MIN_CONF=0.35     # person confidence floor for the gate
WATCH_PHASH_HAMMING=10       # same-scene dedup threshold (<= N of 64 bits)
WATCH_NOVELTY_OVERRIDE=25    # big scene change => bypass cooldown
WATCH_MOTION_HOLD_MS=1500    # keep gate "warm" after last movement
WATCH_KEYFRAME_WINDOW_MS=2500 # window to pick the best frame before sending

# --- Dedup & verdict caching (server) ---
WATCH_VERDICT_TTL_MS=30000   # negative-verdict cache TTL
WATCH_VERIFY_ON_POSITIVE=true # second verify pass only on positive triage

# --- LM Studio local fail-safe fallback ---
# NOTE: canonical name is LMSTUDIO_BASE_URL (what LmStudioProvider reads).
# The old LMSTUDIO_URL name is accepted as a fallback but should not be used.
LMSTUDIO_BASE_URL=ws://127.0.0.1:1234
LMSTUDIO_WATCH_MODEL=lfm-2.5-ucf-1.6b

# --- Video analysis (separate, out-of-scope feature) ---
# NVIDIA_API_KEY is shared with the video pipeline when set.

# Worker port
PORT=3001
