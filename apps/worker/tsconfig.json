{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "./dist",
    "rootDir": "../..",
    "baseUrl": ".",
    "paths": {
      "@/*": ["../../app/*", "../../components/*", "../../lib/*"],
      "convex/_generated/*": ["../../convex/_generated/*"]
    }
  },
  "include": ["**/*.ts", "../../convex/_generated/**/*.ts"]
}
