{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "./dist",
    "rootDir": "../..",
    "baseUrl": ".",
    "paths": {
      "@/*": ["../../app/*", "../../components/*", "../../lib/*", "../../types/*", "../../*"],
      "convex/_generated/*": ["../../convex/_generated/*"],
      "sharp": ["node_modules/sharp"],
      "@lmstudio/sdk": ["node_modules/@lmstudio/sdk"],
      "ffprobe-static": ["node_modules/ffprobe-static"]
    }
  },
  "include": ["**/*.ts", "../../convex/_generated/**/*.ts"]
}
